  <property name="styleSheet">
   <string notr="true">#sidebar_widget QPushButton {
	text-align: left;
	background: transparent;
}

#options_frame {
	border-top: 0.5px solid #4d4d4f;
}

#options_frame QPushButton {
	color: #fff;
	border:none;
	padding: 10px;
	border-radius:5px;
	background: none;
}

#options_frame QFrame {
	border-radius: 5px;
}

#new_chat, #settings {
	border: 1px solid #4d4d4f;
	color: #fff;
	border-radius: 5px;
	padding: 10px;
}

#sidebar_widget,
#chat_list {
	background: #202313;
}

#chat_list {
	border: none;
}

chat_list::item {
	color: #fff;
	padding: 10px;
	border-radius: 5px;
	margin-top: 5px;
	
}

#sidebar_widget QPushButton:hover,
#chat_list::item:hover,
#menu_frame QFrame:hover {
	background: #2a2b32;
}

#input_frame {
	border: 1px solid #e5e5e5;
	background: #fff;
	border-radius: 1.5px;
}

#text_input_area {
	border: none;
}

#send_btn {
	border: none;
}

#send_btn:hover {
	background: #f3f3f3;
}

#output_area {
	border: none;
}

#main_widget,
#output_area_widget {
	background: #fff;
}</string>
